{
  "name": "pi-infinite-context",
  "version": "0.1.0",
  "description": "Extension for long-running sessions. The agent replaces old work in its context with short summaries. The original messages stay saved and searchable.",
  "keywords": ["pi-package"],
  "license": "MIT",
  "author": "fdietze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdietze/pi-infinite-context.git"
  },
  "type": "module",
  "files": ["extensions/infinite-context", "docs/folding.svg", "docs/fold-payoff.png", "docs/reminder-limit.png", "docs/publishing.md", "DESIGN.md"],
  "pi": {
    "extensions": ["extensions/infinite-context/index.ts"]
  },
  "scripts": {
    "typecheck": "tsgo -p tsconfig.json",
    "lint": "oxlint extensions e2e scripts",
    "test": "find extensions scripts -name '*.test.ts' -print0 | xargs -0 -r node --test",
    "publish:ci": "node scripts/publish.ts",
    "ci": "actionlint -ignore '^unexpected key \"queue\" for \"concurrency\" section\\.' && npm run typecheck && npm run lint && npm run test",
    "e2e": "node --test e2e/*.e2e.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@earendil-works/pi-tui": "0.87.0",
    "@types/node": "^22",
    "fast-check": "^4.10.0",
    "typebox": "1.3.7"
  }
}
