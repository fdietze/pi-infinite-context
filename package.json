{
  "name": "pi-infinite-context",
  "version": "0.1.0",
  "description": "Let the pi agent edit its own LLM context: reversibly fold finished or bulky message ranges into stubs, and recover them.",
  "keywords": ["pi-package"],
  "license": "MIT",
  "author": "fdietze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdietze/pi-infinite-context.git"
  },
  "type": "module",
  "pi": {
    "extensions": ["extensions/infinite-context/index.ts"]
  },
  "scripts": {
    "typecheck": "tsgo -p tsconfig.json",
    "lint": "oxlint extensions",
    "test": "find extensions -name '*.test.ts' -print0 | xargs -0 -r node --test",
    "ci": "npm run typecheck && npm run lint && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^22",
    "typebox": "1.3.7"
  }
}
